# Copy to .env and fill in. The CLI reads these from the environment.

# Required to run the vision pass (page reading).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables Rebrickable reconciliation (canonical inventory + part images).
# Get a free key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-4-8
